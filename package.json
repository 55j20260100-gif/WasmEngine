{
  "name": "WasmEngine",
  "version": "1.0.0",
  "main": "Main.js",
  "scripts": {
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.55j.WasmEngine",
    "productName": "WasmEngine",
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
